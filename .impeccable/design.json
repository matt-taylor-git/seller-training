  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Solid red action with a minimum height of 52px.",
      "html": "<button class=\"ds-primary\">Start the meeting</button>",
      "css": ".ds-primary{font-family:var(--ui,Inter,system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:10px 24px;border:0;border-radius:6px;background:var(--action,#cc0000);color:var(--action-ink,#fff);font-size:16px;font-weight:700;cursor:pointer;transition:filter .2s}.ds-primary:hover{filter:brightness(1.08)}.ds-primary:active{transform:scale(.98)}.ds-primary:focus-visible{outline:2px solid var(--accent,#ff8585);outline-offset:4px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Neutral bordered action that does not compete with the primary button.",
      "html": "<button class=\"ds-ghost\">All scenarios</button>",
      "css": ".ds-ghost{font-family:var(--ui,Inter,system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;height:52px;padding:0 20px;border:1px solid var(--line,#424a56);border-radius:6px;background:rgba(255,255,255,.05);color:var(--ink,#f4f5f7);font-size:15px;font-weight:600;cursor:pointer}.ds-ghost:hover{background:rgba(255,255,255,.1)}.ds-ghost:focus-visible{outline:2px solid var(--accent,#ff8585);outline-offset:4px}.ds-ghost:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Presenter controls",
      "kind": "nav",
      "refersTo": "presenter-toggle",
      "description": "Static previews of inactive and active labeled presenter controls.",
      "html": "<div class=\"ds-tools\" role=\"group\" aria-label=\"Presenter controls\"><button class=\"ds-toggle\" aria-pressed=\"false\"><span class=\"ds-switch\" aria-hidden=\"true\"></span>Group mode</button><button class=\"ds-toggle ds-on\" aria-pressed=\"true\"><span class=\"ds-switch\" aria-hidden=\"true\"></span>Signal spotter</button></div>",
      "css": ".ds-tools{display:flex;gap:8px;flex-wrap:wrap}.ds-toggle{font-family:var(--ui,Inter,system-ui,sans-serif);display:inline-flex;align-items:center;gap:8px;min-height:38px;padding:8px 13px;border:1px solid var(--line,#424a56);border-radius:6px;background:rgba(255,255,255,.05);color:var(--ink,#f4f5f7);font-size:13.5px;font-weight:600;cursor:pointer;transition:background .2s}.ds-toggle:hover{background:rgba(255,255,255,.11)}.ds-switch{position:relative;width:30px;height:18px;border-radius:999px;background:rgba(255,255,255,.18)}.ds-switch:after{content:\"\";position:absolute;left:2px;top:2px;width:14px;height:14px;border-radius:50%;background:#fff}.ds-toggle.ds-on{border-color:var(--accent-line,#8e444d);background:var(--accent-soft,#2e1c22)}.ds-on .ds-switch{background:var(--action,#cc0000)}.ds-on .ds-switch:after{transform:translateX(12px)}.ds-toggle:focus-visible{outline:2px solid var(--accent,#ff8585);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-toggle{transition:none}}"
    },
    {
      "name": "Scenario card",
      "kind": "card",
      "refersTo": "scenario-card",
      "description": "A flat clickable scenario summary with a neutral initial avatar.",
      "html": "<button class=\"ds-scenario\"><span class=\"ds-person\"><span class=\"ds-avatar\">DM</span><span><strong>Diane Mercer</strong><span class=\"ds-role\">Chief Financial Officer<br>Brightline Components</span></span></span><span class=\"ds-title\">The Skeptical CFO</span><span class=\"ds-quote\">“Every vendor says AI will transform us. Show me the numbers.”</span><span class=\"ds-card-action\">Brief me →</span></button>",
      "css": ".ds-scenario{font-family:var(--ui,Inter,system-ui,sans-serif);display:flex;flex-direction:column;gap:16px;width:100%;max-width:360px;padding:22px;text-align:left;border:1px solid var(--line,#424a56);border-radius:8px;background:var(--panel,#191d23);color:var(--ink,#f4f5f7);cursor:pointer;transition:border-color .2s,background .2s}.ds-scenario:hover{border-color:var(--accent,#ff8585);background:var(--panel2,#22272f)}.ds-scenario:focus-visible{outline:2px solid var(--accent,#ff8585);outline-offset:4px}.ds-person{display:flex;gap:14px;align-items:center}.ds-person strong{font-size:18px;font-weight:700}.ds-avatar{display:grid;place-items:center;flex:none;width:58px;height:58px;border-radius:50%;background:#343c48;border:1px solid #606c7d;font-size:21px;font-weight:600}.ds-role{display:block;color:var(--muted,#b0b7c2);font-size:13.5px;font-weight:600;line-height:1.35}.ds-title{font-size:15px;font-weight:600}.ds-quote{color:var(--muted,#b0b7c2);font-size:14px;line-height:1.6}.ds-card-action{margin-top:auto;padding-top:18px;border-top:1px solid var(--line,#424a56);font-size:14px;font-weight:600;color:var(--accent,#ff8585)}@media(prefers-reduced-motion:reduce){.ds-scenario{transition:none}}"
    },
    {
      "name": "Metadata chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Noninteractive scenario metadata.",
      "html": "<span class=\"ds-chip\">Manufacturing</span>",
      "css": ".ds-chip{font-family:var(--ui,Inter,system-ui,sans-serif);display:inline-block;padding:4px 8px;border:1px solid var(--line,#424a56);border-radius:4px;background:transparent;color:var(--muted,#b0b7c2);font-size:12px;font-weight:500;line-height:1.4}"
    },
    {
      "name": "Customer message",
      "kind": "custom",
      "refersTo": "customer-message",
      "description": "Neutral message bubble with an explicit speaker label.",
      "html": "<div class=\"ds-customer\"><span class=\"ds-speaker\">Diane Mercer</span>Every vendor that walks in here says AI will transform us.</div>",
      "css": ".ds-customer{font-family:var(--ui,Inter,system-ui,sans-serif);padding:14px 18px;border:1px solid var(--line,#424a56);border-radius:6px 8px 8px 8px;background:var(--panel2,#22272f);color:var(--ink,#f4f5f7);font-size:calc(clamp(15.5px,1.2vw,19px)*var(--fs,1));line-height:1.55}.ds-speaker{display:block;margin-bottom:4px;color:var(--muted,#b0b7c2);font-size:12px;font-weight:800;letter-spacing:.6px;text-transform:uppercase}"
    },
    {
      "name": "Seller message",
      "kind": "custom",
      "refersTo": "seller-message",
      "description": "Red-tinted message bubble with a matching speaker label.",
      "html": "<div class=\"ds-seller\"><span class=\"ds-seller-name\">You · Your Company</span>Can I ask what happened with that pilot, and what you’d need to see to call an AI investment a success?</div>",
      "css": ".ds-seller{font-family:var(--ui,Inter,system-ui,sans-serif);padding:14px 18px;border:1px solid var(--accent-line,#8e444d);border-radius:8px 6px 8px 8px;background:var(--accent-soft,#2e1c22);color:var(--ink,#f4f5f7);font-size:calc(clamp(15.5px,1.2vw,19px)*var(--fs,1));line-height:1.55}.ds-seller-name{display:block;margin-bottom:4px;color:var(--accent-text,#f2bfc3);font-size:12px;font-weight:800;letter-spacing:.6px;text-transform:uppercase}"
    },
    {
      "name": "Response choice",
      "kind": "custom",
      "refersTo": "response-choice",
      "description": "Lettered response with hover and keyboard-focus feedback.",
      "html": "<button class=\"ds-choice\"><span class=\"ds-letter\">A</span><span>What are your top financial priorities this year?</span></button>",
      "css": ".ds-choice{font-family:var(--ui,Inter,system-ui,sans-serif);display:flex;gap:12px;align-items:flex-start;padding:12px 14px;text-align:left;border:1px solid var(--line,#424a56);border-radius:6px;background:var(--panel,#191d23);color:var(--ink,#f4f5f7);font-size:calc(clamp(14px,1.05vw,17px)*var(--fs,1));font-weight:500;line-height:1.45;cursor:pointer;transition:border-color .15s,background .15s,transform .1s}.ds-choice:hover{border-color:var(--accent,#ff8585);background:var(--panel2,#22272f)}.ds-choice:focus-visible{outline:2px solid var(--accent,#ff8585);outline-offset:2px}.ds-choice:active{transform:scale(.99)}.ds-letter{display:grid;place-items:center;flex:none;width:30px;height:30px;border:1px solid var(--line,#424a56);border-radius:4px;background:rgba(255,255,255,.08);font-size:14px;font-weight:600}.ds-choice:hover .ds-letter{background:var(--action,#cc0000);color:var(--action-ink,#fff);border-color:transparent}@media(prefers-reduced-motion:reduce){.ds-choice{transition:none}}"
    },
    {
      "name": "Coaching feedback",
      "kind": "custom",
      "refersTo": "feedback",
      "description": "Quality label and point change on a flat panel.",
      "html": "<div class=\"ds-feedback\"><div class=\"ds-feedback-head\"><span class=\"ds-quality\">Missed opportunity</span><span class=\"ds-points\">+20 pts</span></div><p class=\"ds-feedback-copy\">Partnerships matter later, but leading with credentials ignores her concern.</p></div>",
      "css": ".ds-feedback{font-family:var(--ui,Inter,system-ui,sans-serif);padding:16px 18px;border:1px solid var(--line,#424a56);border-radius:8px;background:var(--panel,#191d23);color:var(--ink,#f4f5f7)}.ds-feedback-head{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:8px}.ds-quality{display:inline-flex;padding:5px 10px;border:1px solid color-mix(in srgb,var(--amber,#d9b77a) 55%,transparent);border-radius:4px;background:color-mix(in srgb,var(--amber,#d9b77a) 20%,transparent);color:var(--amber,#d9b77a);font-size:13px;font-weight:600;letter-spacing:.2px}.ds-points{font-size:18px;font-weight:700;font-variant-numeric:tabular-nums}.ds-feedback-copy{margin:0;font-size:calc(clamp(14.5px,1.1vw,18px)*var(--fs,1));line-height:1.5}"
    }
  ],
